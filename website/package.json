{
  "name": "openrouter-free-models-website",
  "private": true,
  "version": "1.0.0",
  "description": "Hourly updated list of free models on OpenRouter — Cloudflare Workers Cron + Pages",
  "type": "module",
  "scripts": {
    "dev:cron": "wrangler dev --local src/cron.ts",
    "dev:pages": "wrangler pages dev public --kv FREE_MODELS_KV",
    "deploy:cron": "wrangler deploy --config wrangler.toml",
    "deploy:pages": "wrangler pages deploy public --project-name openrouter-free-models",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250828.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.80.0"
  }
}
